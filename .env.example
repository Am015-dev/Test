# Copy to .env and adjust. All values have sane defaults in config.py.

# User-Agent string sent to Nominatim (required by their usage policy).
GEOCODER_USER_AGENT=holargos-scout/1.0 (you@example.com)

# Path to the SQLite database file (default storage).
DB_PATH=data/listings.db

# Scale-up storage: set a full SQLAlchemy URL to use Postgres instead of SQLite.
# Example: postgresql+psycopg://holargos:holargos@db:5432/holargos
# (pip install "psycopg[binary]"; see the optional `db` service in docker-compose.yml)
DATABASE_URL=

# RELIABLE, SCALABLE DATA SOURCE (recommended for production).
# With APIFY_TOKEN set, scraping runs on Apify's cloud (GR residential proxies,
# anti-bot handled) via the maintained xe.gr actor — not IP-throttled, scales by
# area. Get a token at apify.com (~$3.50 / 1000 listings). Leave blank to use the
# free best-effort direct fetch (works often, but XE throttles datacenter IPs).
APIFY_TOKEN=
APIFY_XE_ACTOR=logiover/xe-gr-real-estate-scraper-greece-property-data

# OSRM walking-route base URL (public demo server). Falls back to haversine.
OSRM_BASE_URL=https://router.project-osrm.org

# Set true only behind a TLS-intercepting proxy (keeps TLS strict by default).
SCRAPE_IGNORE_HTTPS_ERRORS=false

# Optional alerts (off by default). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
