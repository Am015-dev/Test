# Copy to .env and adjust. All values have sane defaults in config.py.

# User-Agent string sent to Nominatim (required by their usage policy).
GEOCODER_USER_AGENT=holargos-scout/1.0 (you@example.com)

# Storage. The docker-compose stack runs Postgres (service `db`) and points here.
# Shared Postgres is what lets multiple scraper workers (each on its own Oracle IP)
# write to one database when you scale to more areas. For local non-docker dev,
# blank this out to fall back to the SQLite file at DB_PATH.
DATABASE_URL=postgresql+psycopg://holargos:holargos@db:5432/holargos
DB_PATH=data/listings.db

# OSRM walking-route base URL (public demo server). Falls back to haversine.
OSRM_BASE_URL=https://router.project-osrm.org

# Self-hosted FlareSolverr (free Cloudflare/WAF bypass). When set, Spitogatos and
# Indomio are scraped through it too. Start the service with the compose profile:
#   docker compose --profile flaresolverr up -d
# FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Polite scraping (defaults in config.py). Larger delays = lower chance of XE's
# per-IP rate limit returning empty pages.
# SCRAPE_REQUEST_MIN_S=2.0
# SCRAPE_REQUEST_MAX_S=6.0
# SCRAPE_MAX_RETRIES=4
# SCRAPE_CACHE_TTL_MINUTES=360

# Set true only behind a TLS-intercepting proxy (keeps TLS strict by default).
SCRAPE_IGNORE_HTTPS_ERRORS=false

# Optional daily-digest alerts (off by default; scripts/notify.py is a no-op until
# set). Telegram is easiest: message @BotFather to create a bot for the token, then
# get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after DMing it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
